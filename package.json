{
  "name": "bildergram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kindle e-ink dashboard: Tempelhof Field status and Yorck cinema listings on a battery-powered Paperwhite 3",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types",
    "glyphs": "node tools/gen-glyphs.mjs",
    "kindle:build": "node kindle/build.mjs",
    "kindle:install": "sh kindle/install.sh",
    "kindle:gallery": "node kindle/gallery.mjs",
    "renderer:dev": "node kindle/renderer-dev-server.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "wrangler": "^4.14.0"
  },
  "allowScripts": {
    "workerd@1.20261117.1": true,
    "workerd@1.20261119.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
