{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bildergram",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-19",

  // Kindle hub state (schedule config, last check-in) as small JSON objects.
  // The bucket name predates the hub; the binding name is what the code uses.
  "r2_buckets": [
    {
      "binding": "DISPLAY_ASSETS",
      "bucket_name": "trmnl-display-assets"
    }
  ],

  // Vercel screen renderer (api/screen.mjs). Secrets: ADMIN_TOKEN,
  // RENDERER_TOKEN, DEVICE_TOKEN_KINDLE_01 (wrangler secret put).
  "vars": {
    "RENDERER_URL": "https://bildergram-kino.vercel.app",
    // Fondfolio's orders this month, for the Fondfolio Sales card (Bearer FONDFOLIO_TOKEN, a secret).
    "FONDFOLIO_URL": "https://my.fondfolio.com/api/stats/orders-this-month"
  },

  // No cron triggers: the Kindle checks in when it needs data. The explicit
  // empty list removes the old 15-minute render schedule on deploy.
  "triggers": {
    "crons": []
  },

  // Admin SPA — the @cloudflare/vite-plugin maps the built client here
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  }
}
