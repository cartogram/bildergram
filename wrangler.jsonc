{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bildergram",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-19",

  // Kindle hub state (schedule config, last check-in) as small JSON objects.
  // The bucket name predates the hub; the binding name is what the code uses.
  "r2_buckets": [
    {
      "binding": "DISPLAY_ASSETS",
      "bucket_name": "trmnl-display-assets"
    }
  ],

  // Vercel cinema renderer (api/kino.mjs). Secrets: ADMIN_TOKEN, KINO_TOKEN,
  // DEVICE_TOKEN_KINDLE_01 (wrangler secret put).
  "vars": {
    "KINO_URL": "https://bildergram-kino.vercel.app"
  },

  // No cron triggers: the Kindle checks in when it needs data. The explicit
  // empty list removes the old 15-minute render schedule on deploy.
  "triggers": {
    "crons": []
  },

  // Admin SPA — the @cloudflare/vite-plugin maps the built client here
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  }
}
