{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev --ignore-scripts",
  "buildCommand": "",
  "outputDirectory": "kindle/vercel-public",
  "functions": {
    "api/*.mjs": {
      "includeFiles": "{assets/fonts/Arimo.ttf,assets/fonts/Arimo-Bold.ttf,kindle/lib/*.ts,kindle/lib/*.mjs,kindle/lib/modules/*.mjs,kindle/data/*.json,node_modules/@resvg/resvg-wasm/index_bg.wasm}",
      "maxDuration": 30
    }
  }
}
